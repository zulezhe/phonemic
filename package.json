{
  "name": "phonemic-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "phone:build": "npm --prefix phone run build",
    "tauri": "tauri",
    "tauri:dev": "npm run phone:build && tauri dev",
    "tauri:build": "npm run phone:build && tauri build",
    "dev:setup": "bash scripts/setup-dev-identity.sh",
    "dev:app": "bash scripts/dev-app.sh",
    "server:dev": "npm run phone:build && cargo run --manifest-path src-tauri/Cargo.toml --bin phonemic-server --"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.1.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.3"
  }
}
